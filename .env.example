# GitHub App（不是 App ID；用 Client ID / Client secret）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# 会话签名密钥：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=

# DeepSeek / OpenAI 兼容接口
DEEPSEEK_API_KEY=

# Redis（搜索缓存、单飞锁、限流）
REDIS_URL=redis://127.0.0.1:6379/0

# 本地数据
DATABASE_PATH=./lookingfor.db
NICEGUI_STORAGE_PATH=./.nicegui

# 可选：把 NiceGUI 会话放进 Redis（多实例/无持久磁盘时）
# NICEGUI_REDIS_URL=redis://127.0.0.1:6379/1
# NICEGUI_REDIS_KEY_PREFIX=lookingfor:

# 本地开发：HOST 127.0.0.1，RELOAD/SHOW 打开
# 生产：HOST 0.0.0.0，PORT 用平台端口，RELOAD/SHOW 关闭
HOST=127.0.0.1
PORT=8080
RELOAD=1
SHOW=1
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

# docker compose / Caddy 使用：例如 1-2-3-4.sslip.io 或你的域名
DOMAIN=

# 备份目录（Docker 中建议 /data/backups）
BACKUP_DIR=./backups
